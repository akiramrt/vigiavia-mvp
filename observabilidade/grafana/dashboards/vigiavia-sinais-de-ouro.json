    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(http_requests_total{job=\"$job\"}[5m]))",
     "legendFormat": "req/s",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 9,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Erros 5xx",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(rate(http_requests_total{job=\"$job\", status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_requests_total{job=\"$job\"}[5m]))",
     "legendFormat": "5xx",
